# ==============================================================================
# Variables d'Environnement - Dev avec Docker (Rallly & Authentik)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Reverse Proxy (Traefik v3)
# ------------------------------------------------------------------------------
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# ------------------------------------------------------------------------------
# 2. Domaines Locaux
# (Resolus nativement en 127.0.0.1 sur Linux / macOS / Windows)
# ------------------------------------------------------------------------------
RALLLY_HOSTNAME=rallly.localhost
AUTHENTIK_HOSTNAME=auth.localhost
MAILPIT_HOSTNAME=mail.localhost

# ------------------------------------------------------------------------------
# 3. Authentik (Identity Provider)
# ------------------------------------------------------------------------------
# Cle secrete generable via: openssl rand -base64 32
AUTHENTIK_SECRET_KEY=insecure_authentik_dev_key_replace_in_prod_123456789
AUTHENTIK_ERROR_REPORTING_ENABLED=false

# Base PostgreSQL dediee a Authentik
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=authentik_secure_db_pass_123

# Cache Redis dedie a Authentik
AUTHENTIK_REDIS_PASSWORD=authentik_redis_pass_123

# ------------------------------------------------------------------------------
# 4. Rallly (Application Web)
# ------------------------------------------------------------------------------
EMAIL_LOGIN_ENABLED=false
# Cle secrete de session (minimum 32 caracteres)
RALLLY_SECRET_PASSWORD=super_secret_password_for_rallly_session_min_32_chars
RALLLY_SUPPORT_EMAIL=support@example.com

# Base PostgreSQL dediee a Rallly
RALLLY_POSTGRES_DB=rallly
RALLLY_POSTGRES_USER=rallly
RALLLY_POSTGRES_PASSWORD=rallly_secure_db_pass_123

# Port PostgreSQL expose pour pnpm dev en local (hors Docker si besoin)
RALLLY_POSTGRES_EXPOSED_PORT=5450

# ------------------------------------------------------------------------------
# 5. Federation OIDC (Authentik -> Rallly)
# ------------------------------------------------------------------------------
OIDC_NAME=Authentik
OIDC_CLIENT_ID=rallly-client-id
OIDC_CLIENT_SECRET=rallly-client-secret
OIDC_DISCOVERY_URL=http://auth.localhost/application/o/rallly/.well-known/openid-configuration
